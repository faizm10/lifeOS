# Required for sessions (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Server URL (no trailing path)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Optional — SQLite file path (defaults to ./auth.db, or /data/auth.db on Fly when mounted)
# DATABASE_PATH=
